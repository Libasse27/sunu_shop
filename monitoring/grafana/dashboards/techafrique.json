{
  "title": "SunuShop — Production",
  "uid": "sunushop-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["sunushop", "production"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Requêtes / min",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "sum(rate(ta_http_requests_total[1m])) * 60", "legendFormat": "req/min" }]
    },
    {
      "id": 2, "type": "stat", "title": "Taux d'erreur",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "graphMode": "area", "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}] } },
      "targets": [{ "expr": "sum(rate(ta_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(ta_http_requests_total[5m])) * 100", "legendFormat": "erreurs %" }]
    },
    {
      "id": 3, "type": "stat", "title": "Connexions Socket.io",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background" },
      "targets": [{ "expr": "ta_socket_active_connections", "legendFormat": "connexions" }]
    },
    {
      "id": 4, "type": "stat", "title": "Mémoire Node.js",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "ta_node_process_heap_bytes / 1024 / 1024", "legendFormat": "MB utilisés" }]
    },
    {
      "id": 5, "type": "stat", "title": "Jobs email en attente",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background", "thresholds": { "mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 200}] } },
      "targets": [{ "expr": "ta_queue_depth{queue=\"emails\",state=\"waiting\"}", "legendFormat": "en attente" }]
    },
    {
      "id": 6, "type": "stat", "title": "Uptime API",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "colorMode": "background" },
      "targets": [{ "expr": "ta_node_process_uptime_seconds / 3600", "legendFormat": "heures" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Requêtes HTTP par seconde",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "targets": [
        { "expr": "sum(rate(ta_http_requests_total{status_code=~\"2..\"}[1m]))", "legendFormat": "2xx" },
        { "expr": "sum(rate(ta_http_requests_total{status_code=~\"4..\"}[1m]))", "legendFormat": "4xx" },
        { "expr": "sum(rate(ta_http_requests_total{status_code=~\"5..\"}[1m]))", "legendFormat": "5xx" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Latence P95 par route (ms)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(ta_http_request_duration_ms_bucket[5m])) by (le, route))", "legendFormat": "P95 {{route}}" },
        { "expr": "histogram_quantile(0.50, sum(rate(ta_http_request_duration_ms_bucket[5m])) by (le))", "legendFormat": "P50 global" }
      ]
    },
    {
      "id": 20, "type": "timeseries", "title": "Mémoire heap Node.js",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "MB" } },
      "targets": [
        { "expr": "ta_node_process_heap_bytes / 1024 / 1024", "legendFormat": "Heap utilisé" },
        { "expr": "ta_node_process_heap_size_bytes / 1024 / 1024", "legendFormat": "Heap total" }
      ]
    },
    {
      "id": 21, "type": "timeseries", "title": "CPU Node.js",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [{ "expr": "rate(ta_node_process_cpu_seconds_total[1m])", "legendFormat": "CPU %" }]
    },
    {
      "id": 22, "type": "timeseries", "title": "Cache Redis — Hits vs Misses",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(ta_redis_cache_hits_total[5m])", "legendFormat": "Hits/s" },
        { "expr": "rate(ta_redis_cache_misses_total[5m])", "legendFormat": "Misses/s" }
      ]
    },
    {
      "id": 30, "type": "timeseries", "title": "Queue BullMQ — Jobs",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "ta_queue_depth{state=\"waiting\"}", "legendFormat": "{{queue}} en attente" },
        { "expr": "ta_queue_depth{state=\"active\"}", "legendFormat": "{{queue}} actifs" },
        { "expr": "ta_queue_depth{state=\"failed\"}", "legendFormat": "{{queue}} échoués" }
      ]
    },
    {
      "id": 31, "type": "timeseries", "title": "Taux de succès des jobs",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(ta_queue_jobs_completed_total[5m])", "legendFormat": "{{queue}} terminés/s" },
        { "expr": "rate(ta_queue_jobs_failed_total[5m])", "legendFormat": "{{queue}} échoués/s" }
      ]
    },
    {
      "id": 40, "type": "logs", "title": "Logs récents (Loki)",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [{ "expr": "{job=\"sunushop\"}", "legendFormat": "" }]
    }
  ]
}
