# =============================================================
# SunuShop — Template variables d'environnement
# Copier en .env et remplir toutes les valeurs
# ⚠️  NE JAMAIS commiter .env dans git !
# =============================================================

# ------ Serveur ------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ------ MongoDB ------
MONGODB_URI=mongodb://localhost:27017/sunushop
# MongoDB Atlas (cloud) :
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sunushop

# ------ JWT ------
# Générer : openssl rand -hex 64
JWT_ACCESS_SECRET=your_access_secret_key_min_64_chars_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_min_64_chars_change_this_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ------ Redis ------
# Dev : redis://localhost:6379 (sans mot de passe)
# Prod : redis://:MOT_DE_PASSE@redis:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ------ Cloudinary (upload images produits) ------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------ Stripe (paiement carte bancaire) ------
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ------ Orange Money (Sénégal, Mali, Guinée) ------
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_API_URL=https://api.orange.com

# ------ Wave (Sénégal, Mali) ------
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_API_URL=https://api.wave.com

# ------ Email SMTP ------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@sunushop.sn
EMAIL_FROM_NAME=SunuShop

# ------ OAuth Google ------
# https://console.cloud.google.com → Identifiants → OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ------ OAuth Facebook ------
# https://developers.facebook.com → Mon application → Paramètres
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# ------ Monitoring ------
# Générer : openssl rand -hex 32
METRICS_SECRET=change_this_secret_token_for_prometheus_metrics
GRAFANA_PASSWORD=change_this_grafana_admin_password

# ------ Logging ------
LOG_LEVEL=info
