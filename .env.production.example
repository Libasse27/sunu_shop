# =============================================================
# SunuShop — Variables d'environnement PRODUCTION
# Copier en .env.production et remplir toutes les valeurs
# ⚠️  NE JAMAIS commiter .env.production dans git !
# =============================================================

# ------ Serveur ------
NODE_ENV=production
PORT=5000
CLIENT_URL=https://www.sunushop.sn
SERVER_URL=https://www.sunushop.sn

# ------ MongoDB ------
# Identifiants MongoDB (utilisés aussi par le service backup)
MONGO_ROOT_USER=sunushop_admin
MONGO_ROOT_PASSWORD=CHANGER_CE_MOT_DE_PASSE_FORT_32_CHARS_MIN
# URI complète (Docker interne — ne pas modifier le host "mongo")
MONGODB_URI=mongodb://sunushop_admin:CHANGER_CE_MOT_DE_PASSE@mongo:27017/sunushop?authSource=admin

# ------ JWT ------
# Générer : openssl rand -hex 64
JWT_ACCESS_SECRET=REMPLACER_PAR_64_CHARS_ALEATOIRES_ACCESS_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
JWT_REFRESH_SECRET=REMPLACER_PAR_64_CHARS_ALEATOIRES_REFRESH_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ------ Cloudinary (images produits) ------
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# ------ Stripe ------
STRIPE_SECRET_KEY=VOTRE_CLE_SECRETE_STRIPE
STRIPE_PUBLISHABLE_KEY=VOTRE_CLE_PUBLIQUE_STRIPE
STRIPE_WEBHOOK_SECRET=VOTRE_SECRET_WEBHOOK_STRIPE

# ------ Orange Money (Sénégal, Mali, Guinée) ------
ORANGE_MONEY_CLIENT_ID=votre_client_id
ORANGE_MONEY_CLIENT_SECRET=votre_client_secret
ORANGE_MONEY_MERCHANT_KEY=votre_merchant_key
ORANGE_MONEY_API_URL=https://api.orange.com

# ------ Wave (Sénégal, Mali) ------
WAVE_API_KEY=votre_wave_api_key
WAVE_WEBHOOK_SECRET=votre_webhook_secret
WAVE_API_URL=https://api.wave.com

# ------ Email SMTP ------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@sunushop.sn
SMTP_PASS=votre_app_password
EMAIL_FROM=noreply@sunushop.sn
EMAIL_FROM_NAME=SunuShop

# ------ OAuth Google ------
GOOGLE_CLIENT_ID=votre_google_client_id
GOOGLE_CLIENT_SECRET=votre_google_client_secret

# ------ OAuth Facebook ------
FACEBOOK_APP_ID=votre_facebook_app_id
FACEBOOK_APP_SECRET=votre_facebook_app_secret

# ------ Redis ------
REDIS_URL=redis://:CHANGER_MOT_DE_PASSE_REDIS@redis:6379
REDIS_PASSWORD=CHANGER_MOT_DE_PASSE_REDIS_32_CHARS

# ------ Logging ------
LOG_LEVEL=warn

# ------ Monitoring ------
# Générer : openssl rand -hex 32
METRICS_SECRET=CHANGER_CE_TOKEN_SECRET_METRIQUES
GRAFANA_PASSWORD=CHANGER_MOT_DE_PASSE_GRAFANA_FORT

# =============================================================
# BACKUP AUTOMATIQUE — Cloudflare R2 (optionnel)
# Laisser vide pour un backup local uniquement
#
# Configuration Cloudflare R2 :
#   1. Dashboard Cloudflare → R2 → Créer un bucket
#   2. Créer une API Token avec permissions R2:Edit
#   3. Remplir les variables ci-dessous
# =============================================================

# ID de compte Cloudflare (visible dans Dashboard → Overview → Account ID)
BACKUP_R2_ACCOUNT_ID=

# Credentials API Token R2 (pas les clés de compte principal !)
# Créer sur : https://dash.cloudflare.com/profile/api-tokens
BACKUP_R2_ACCESS_KEY=
BACKUP_R2_SECRET_KEY=

# Nom du bucket R2 créé pour les backups
BACKUP_R2_BUCKET=sunushop-backups

# =============================================================
# BACKUP — Notifications webhook (optionnel)
# Compatible Slack, Discord, n8n, Make, Zapier, etc.
# Laisser vide pour désactiver les notifications
# =============================================================
BACKUP_WEBHOOK_URL=

# =============================================================
# ALERTES GRAFANA — Notifications monitoring
# =============================================================

# Email destinataire des alertes (peut différer de EMAIL_FROM)
ALERT_EMAIL=admin@sunushop.sn

# Webhook générique (Slack, Discord, n8n, Make, Zapier...)
# Laisser vide pour désactiver
ALERT_WEBHOOK_URL=

# Telegram — bot token + chat ID
# Créer un bot via @BotFather, obtenir le chat ID via @userinfobot
# Laisser vide pour désactiver
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
