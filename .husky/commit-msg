#!/bin/sh
# Valide le format des messages de commit (Conventional Commits)
# Format attendu : type(scope): description
# Exemples : feat(auth): add OAuth Google, fix(cart): correct price calculation
commit_msg=$(cat "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?: .{1,100}$'
if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "❌  Message de commit invalide : $commit_msg"
  echo ""
  echo "Format attendu : type(scope): description"
  echo "Types autorisés : feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "Exemples :"
  echo "  feat(auth): add OAuth Google login"
  echo "  fix(cart): correct variant price calculation"
  echo "  refactor(wishlist): sync with server on login"
  echo ""
  exit 1
fi
