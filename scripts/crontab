# =============================================================
# Crontab — Sunu Shop Backup automatique
# Copié dans /etc/cron.d/sunushop-backup par Dockerfile.backup
#
# IMPORTANT : . /etc/backup_env est nécessaire car cron ne reçoit
# pas les variables d'environnement Docker. entrypoint.sh les écrit
# dans /etc/backup_env au démarrage du container.
# =============================================================
MAILTO=""
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Backup quotidien à 2h00 du matin (heure serveur)
0 2 * * * root . /etc/backup_env; /usr/local/bin/backup.sh >> /var/log/backup.log 2>&1

# Nettoyage des logs de backup > 30 jours
0 3 * * 0 root find /var/log -name "backup*.log*" -mtime +30 -delete 2>/dev/null || true
