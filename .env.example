# ============================================================
# TechAfrique — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# Serveur
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB — Réseau local (recommandé)
MONGODB_URI=mongodb://localhost:27017/techafrique
# MongoDB Atlas (cloud) — alternative
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/techafrique

# JWT
JWT_ACCESS_SECRET=your_access_secret_key_min_64_chars_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_min_64_chars_change_this_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary (upload images produits)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe (paiement carte bancaire internationale)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Orange Money (Sénégal, Mali, Guinée)
ORANGE_MONEY_CLIENT_ID=your_client_id
ORANGE_MONEY_CLIENT_SECRET=your_client_secret
ORANGE_MONEY_MERCHANT_KEY=your_merchant_key
ORANGE_MONEY_API_URL=https://api.orange.com

# Wave (Sénégal, Mali)
WAVE_API_KEY=your_wave_api_key
WAVE_WEBHOOK_SECRET=your_webhook_secret
WAVE_API_URL=https://api.wave.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@techafrique.sn
EMAIL_FROM_NAME=TechAfrique

# Redis
REDIS_URL=redis://:dev-redis-secret-change-me@localhost:6379
REDIS_PASSWORD=dev-redis-secret-change-me

# Logging
LOG_LEVEL=info

# Monitoring (dev)
METRICS_SECRET=dev-metrics-secret
GRAFANA_PASSWORD=admin

# ─── Analytics & Marketing (frontend — préfixe VITE_ obligatoire) ────────────
# Laisser vide en dev pour désactiver les trackers
VITE_GTM_ID=
VITE_FB_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
